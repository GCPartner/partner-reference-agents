# ==============================================================================
# Dun & Bradstreet (D&B) MCP Apps Server — Environment & Deployment Template
# Copy this file to `.env.deploy` (or `.env`) and fill in your values.
# Note: `.env` and `.env.deploy` are excluded by `.gitignore`.
# ==============================================================================

# 1. Google Cloud Run Deployment Target
PROJECT_ID="your-gcp-project-id"
PROJECT_NUMBER="000000000000"
REGION="us-central1"
SERVICE_NAME="dnb-mcp-apps-server"
PUBLIC_BASE_URL="https://dnb-mcp-apps-server-000000000000.us-central1.run.app"

# 2. Upstream Dun & Bradstreet MCP Server (https://plus.dnb.com/v2/mcp)
DNB_UPSTREAM_MCP_URL="https://plus.dnb.com/v2/mcp"
# Optional static D&B Bearer token (if not using Discovery Engine dynamic token refresh)
DNB_MCP_BEARER_TOKEN=""

# 3. Optional Discovery Engine Connector for Dynamic Upstream D&B Token Refresh
DNB_GE_PROJECT_NUMBER="000000000000"
DNB_GE_CONNECTOR_RESOURCE="projects/000000000000/locations/global/collections/your-dnb-connector-id/dataConnector"
GOOGLE_ADC_CLIENT_ID=""
GOOGLE_ADC_CLIENT_SECRET=""
GOOGLE_ADC_REFRESH_TOKEN=""

# 4. OAuth 2.0 Credentials for Gemini Enterprise / MCP Client Authentication
GOOGLE_OAUTH_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
MCP_AUTH_SIGNING_SECRET=""

# 5. Gemini Enterprise Custom MCP Registration Metadata
GE_APPS_COLLECTION_ID="dnb-mcp-apps"
