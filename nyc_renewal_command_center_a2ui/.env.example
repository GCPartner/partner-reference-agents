# ==============================================================================
# Renewal Command Center (A2UI v0.9 Canvas Skill) — Deployment Configuration
# Copy this file to `.env` (excluded by `.gitignore`) or pass CLI flags to
# `deploy_skill.py`. Never commit real project numbers or credentials.
# ==============================================================================

# 1. Google Cloud / Gemini Enterprise Target
PROJECT_NUMBER="000000000000"
ENGINE_ID="global-gemini-enterprise"

# Optional: Existing private skill ID to patch in-place (e.g. private-skill-xxxxxxxx)
EXISTING_SKILL_ID=""

# Optional: Comma-separated Sobi Agent IDs to mount the skill onto (e.g. sobi-xxxxxxxx)
SOBI_AGENT_IDS=""

# 2. Optional Explicit MCP DataConnector Overrides
# (If left empty, `deploy_skill.py` auto-discovers registered connectors in PROJECT_NUMBER)
SALESFORCE_MCP_CONNECTOR=""
SMARTSHEET_MCP_CONNECTOR=""
DNB_MCP_CONNECTOR=""
JIRA_MCP_CONNECTOR=""
SALESFORCE_ORG_BASE_URL=""
